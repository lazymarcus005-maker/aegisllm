FROM golang:1.25.13-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /out/fakeragauth ./cmd/fakeragauth
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fakeragauth /fakeragauth
USER nonroot:nonroot
ENTRYPOINT ["/fakeragauth"]
