FROM golang:1.25.13 AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/fakefleetcontrolplane ./cmd/fakefleetcontrolplane

FROM gcr.io/distroless/static:nonroot
COPY --from=build /out/fakefleetcontrolplane /fakefleetcontrolplane
USER nonroot:nonroot
EXPOSE 8092
ENTRYPOINT ["/fakefleetcontrolplane"]
