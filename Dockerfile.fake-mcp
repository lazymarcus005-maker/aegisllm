FROM golang:1.25.13-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/fakemcp ./cmd/fakemcp
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /bin/fake-mcp ./cmd/fakemcp

FROM alpine:3.20
COPY --from=build /bin/fake-mcp /bin/fake-mcp
USER nobody
ENTRYPOINT ["/bin/fake-mcp"]
