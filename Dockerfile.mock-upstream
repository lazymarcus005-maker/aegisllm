FROM golang:1.25.13-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/mockupstream ./cmd/mockupstream
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /bin/mock-upstream ./cmd/mockupstream

FROM alpine:3.20
COPY --from=build /bin/mock-upstream /bin/mock-upstream
USER nobody
ENTRYPOINT ["/bin/mock-upstream"]
