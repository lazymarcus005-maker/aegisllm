# Production profile: copy into your deployment system, never commit the
# populated file. Every secret below must come from a secret manager.
DEPLOYMENT_PROFILE=production
SECURITY_MODE=enforce
LISTEN_ADDR=:8080
LOG_LEVEL=info

# P2.1 private authenticated extraction. Replace placeholders through the
# deployment secret manager; never commit real endpoints or key material.
DLP_ATTACHMENT_ENABLED=true
DLP_ATTACHMENT_ADAPTER=http
DLP_ATTACHMENT_EXTRACTOR_URL=https://extractor.example.invalid
DLP_ATTACHMENT_ALLOWED_HOSTS=media.example.invalid,extractor.example.invalid
DLP_ATTACHMENT_ALLOW_PRIVATE_HOSTS=true
DLP_ATTACHMENT_TLS_CA_FILE=/run/secrets/aegis-attachment-ca.pem
DLP_ATTACHMENT_TLS_CERT_FILE=/run/secrets/aegis-attachment-client.crt
DLP_ATTACHMENT_TLS_KEY_FILE=/run/secrets/aegis-attachment-client.key
DLP_ATTACHMENT_TLS_SERVER_NAME=extractor.example.invalid

# Durable audit is mandatory in production. Mount HMAC/encryption/SIEM
# material from the deployment secret manager; delivery is at-least-once.
AUDIT_WAL_DIR=/var/lib/aegisllm/audit
AUDIT_SEGMENT_BYTES=67108864
AUDIT_MAX_BYTES=4294967296
AUDIT_RETENTION=720h
AUDIT_FSYNC=sync
AUDIT_FAILURE_MODE=fail_closed
AUDIT_HMAC_KEY_FILE=/run/secrets/aegis-audit-hmac-key
# AUDIT_ENCRYPTION_KEYRING_FILE=/run/secrets/aegis-audit-keyring.json
# AUDIT_SIEM_URL=https://siem.example.invalid/ingest
# AUDIT_SIEM_AUTH_FILE=/run/secrets/aegis-siem-token
# AUDIT_SIEM_CA_FILE=/run/secrets/aegis-siem-ca.pem
# AUDIT_SIEM_CERT_FILE=/run/secrets/aegis-siem-client.crt
# AUDIT_SIEM_KEY_FILE=/run/secrets/aegis-siem-client.key
# AUDIT_SIEM_SERVER_NAME=siem.example.invalid

# Choose exactly one listener contract. Direct TLS is shown here; the
# alternative is TLS_TERMINATED_BY_TRUSTED_EDGE=true with a reviewed edge
# identity/forwarding contract. Never enable the development plaintext waiver.
INBOUND_TLS_CERT_FILE=/run/secrets/aegis-gateway.crt
INBOUND_TLS_KEY_FILE=/run/secrets/aegis-gateway.key
INBOUND_MTLS_MODE=off
TLS_MIN_VERSION=1.2
TLS_RELOAD_INTERVAL=2s

# Authenticated ingress is mandatory in production. Mount the public key from
# a secret/configuration volume; never place a private key or token in this repo.
AUTH_MODE=jwt
JWT_PUBLIC_KEY_FILE=/run/secrets/aegis-jwt-public.pem
JWT_ISSUER=https://issuer.example.invalid
JWT_AUDIENCE=aegisllm
JWT_TENANT_CLAIM=tenant_id
JWT_APPLICATION_CLAIM=azp
JWT_SUBJECT_CLAIM=sub
JWT_ROLES_CLAIM=roles
JWT_PROVIDER_CLAIM=provider

# Use a reviewed strict registry. Each production route references only
# file-backed auth/TLS material; provider boundaries are declared in this file.
UPSTREAM_REGISTRY_FILE=/etc/aegis/upstreams.yaml
UPSTREAM_DIAL_TIMEOUT=5s
UPSTREAM_TLS_HANDSHAKE_TIMEOUT=5s
UPSTREAM_RESPONSE_HEADER_TIMEOUT=30s
UPSTREAM_REQUEST_TIMEOUT=2m
UPSTREAM_IDLE_CONN_TIMEOUT=90s
UPSTREAM_MAX_IDLE_CONNS=100
UPSTREAM_BREAKER_FAILURE_THRESHOLD=3
UPSTREAM_BREAKER_OPEN_INTERVAL=30s

# Optional semantic dependency; if enabled in production it must be HTTPS.
# LAYA_URL=https://laya.example.invalid:8300
# LAYA_TLS_CA_FILE=/run/secrets/aegis-laya-ca.pem
# LAYA_TLS_CERT_FILE=/run/secrets/aegis-laya-client.crt
# LAYA_TLS_KEY_FILE=/run/secrets/aegis-laya-client.key
# LAYA_TLS_SERVER_NAME=laya.example.invalid

MAX_BODY_BYTES=1048576
MAX_RESPONSE_BYTES=4194304
MAX_PROMPT_CHARS=65536
MAX_STREAM_DURATION=5m
MAX_SSE_EVENT_BYTES=65536
STREAM_INSPECTION_WINDOW=4096
MAX_BUFFERED_STREAM_BYTES=1048576
STREAM_FLUSH_INTERVAL=25ms
STREAM_FAIL_CLOSED=true
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=2m
SERVER_SHUTDOWN_TIMEOUT=10s
REQUESTS_PER_SECOND=10
RATE_BURST=20
MAX_CONCURRENT_REQUESTS=16
MAX_CONCURRENT_LAYA=4
LIMITER_MAX_KEYS=10000
LIMITER_KEY_IDLE_TIMEOUT=10m

# Versioned assets are shipped in the image; keep these paths unchanged unless
# the image is rebuilt with reviewed replacements.
POLICY_FILE=policies/enterprise-default.yaml
QUESTIONS_FILE=questions/security-v1.yaml
THRESHOLDS_FILE=policies/thresholds-security-v1.yaml

# Required production protections. Do not use these literal placeholders.
TOKEN_VAULT_KEYRING_FILE=/run/secrets/aegis-vault-keyring.json
TOKEN_VAULT_REDIS_URL=rediss://redis.example.invalid:6379/0
TOKEN_VAULT_REDIS_CA_FILE=/run/secrets/aegis-redis-ca.pem
# Optional Redis mTLS:
# TOKEN_VAULT_REDIS_CERT_FILE=/run/secrets/aegis-redis-client.crt
# TOKEN_VAULT_REDIS_KEY_FILE=/run/secrets/aegis-redis-client.key
TOKEN_VAULT_REDIS_SERVER_NAME=redis.example.invalid
TELEMETRY_HMAC_KEY_FILE=/run/secrets/aegis-telemetry-hmac-key
TOKEN_VAULT_TTL=24h
