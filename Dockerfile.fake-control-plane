FROM golang:1.25.13-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/fakecontrolplane ./cmd/fakecontrolplane
FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/fakecontrolplane /fakecontrolplane
ENTRYPOINT ["/fakecontrolplane"]
