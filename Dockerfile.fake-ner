# CI-only synthetic NER contract fixture; never use for production quality.
FROM golang:1.25.13-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=0 go build -o /bin/fake-ner ./cmd/fakener

FROM alpine:3.20
COPY --from=build /bin/fake-ner /bin/fake-ner
USER 65534:65534
ENTRYPOINT ["/bin/fake-ner"]
