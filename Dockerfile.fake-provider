FROM golang:1-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY web ./web
RUN CGO_ENABLED=0 go build -o /bin/fakeprovider ./cmd/fakeprovider

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
COPY --from=build /bin/fakeprovider /bin/fakeprovider
USER 65534:65534
ENTRYPOINT ["/bin/fakeprovider"]
