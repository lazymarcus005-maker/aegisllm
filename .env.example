# Gateway
LISTEN_ADDR=:8080
LOG_LEVEL=info
DEPLOYMENT_PROFILE=development

# Listener TLS is optional in development. Production requires these mounted
# files unless TLS_TERMINATED_BY_TRUSTED_EDGE=true is explicitly contracted.
# INBOUND_TLS_CERT_FILE=/run/secrets/gateway.crt
# INBOUND_TLS_KEY_FILE=/run/secrets/gateway.key
# INBOUND_TLS_CLIENT_CA_FILE=/run/secrets/client-ca.pem
INBOUND_MTLS_MODE=off
TLS_MIN_VERSION=1.2
TLS_RELOAD_INTERVAL=2s

# Upstream LLM Gateway
UPSTREAM_BASE_URL=http://localhost:9090
UPSTREAM_AUTH_MODE=none
# Used when UPSTREAM_AUTH_MODE=bearer
# UPSTREAM_API_KEY=
# UPSTREAM_API_KEY_FILE=/run/secrets/upstream-api-key
# Used when UPSTREAM_AUTH_MODE=header
# UPSTREAM_AUTH_HEADER_NAME=X-Api-Key
# UPSTREAM_AUTH_HEADER_VALUE=
# UPSTREAM_AUTH_HEADER_VALUE_FILE=/run/secrets/upstream-header-value
# UPSTREAM_TLS_CA_FILE=/run/secrets/upstream-ca.pem
# UPSTREAM_TLS_CERT_FILE=/run/secrets/gateway-upstream.crt
# UPSTREAM_TLS_KEY_FILE=/run/secrets/gateway-upstream.key
# UPSTREAM_TLS_SERVER_NAME=llm-gateway.example.invalid

# Request limits (SEC-012: oversized input protection)
MAX_BODY_BYTES=1048576
MAX_RESPONSE_BYTES=4194304
MAX_PROMPT_CHARS=65536
MAX_STREAM_DURATION=5m
MAX_SSE_EVENT_BYTES=65536
STREAM_INSPECTION_WINDOW=4096
MAX_BUFFERED_STREAM_BYTES=1048576
STREAM_FLUSH_INTERVAL=25ms
STREAM_FAIL_CLOSED=true

# Upstream transport bounds. No global HTTP write timeout is used: stream
# lifetime is bounded separately by MAX_STREAM_DURATION.
UPSTREAM_DIAL_TIMEOUT=5s
UPSTREAM_TLS_HANDSHAKE_TIMEOUT=5s
UPSTREAM_RESPONSE_HEADER_TIMEOUT=30s
UPSTREAM_REQUEST_TIMEOUT=2m
UPSTREAM_IDLE_CONN_TIMEOUT=90s
UPSTREAM_MAX_IDLE_CONNS=100
UPSTREAM_BREAKER_FAILURE_THRESHOLD=3
UPSTREAM_BREAKER_OPEN_INTERVAL=30s

# Server and process-local abuse controls. Limits are per verified
# tenant/application in JWT mode; development falls back to application/IP.
SERVER_READ_HEADER_TIMEOUT=10s
SERVER_READ_TIMEOUT=30s
SERVER_IDLE_TIMEOUT=2m
SERVER_SHUTDOWN_TIMEOUT=10s
REQUESTS_PER_SECOND=10
RATE_BURST=20
MAX_CONCURRENT_REQUESTS=16
MAX_CONCURRENT_LAYA=4
LIMITER_MAX_KEYS=10000
LIMITER_KEY_IDLE_TIMEOUT=10m

# Security mode: off | shadow | enforce
SECURITY_MODE=off

# P2.2 retrieval authorization. `off` preserves development compatibility;
# detected RAG is still fail-closed in production. Production uses private
# HTTPS/mTLS and a reviewed policy profile.
RAG_AUTH_MODE=off
RAG_AUTH_ADAPTER=deny
# RAG_AUTH_URL=https://rag-auth.example.invalid
# RAG_AUTH_CA_FILE=/run/secrets/rag-auth-ca.pem
# RAG_AUTH_CERT_FILE=/run/secrets/rag-auth-client.crt
# RAG_AUTH_KEY_FILE=/run/secrets/rag-auth-client.key
# RAG_AUTH_SERVER_NAME=rag-auth.example.invalid
RAG_AUTH_TIMEOUT=5s
RAG_MAX_RESULTS=64
RAG_MAX_RESULT_BYTES=1048576
RAG_MAX_DEPTH=8
RAG_MAX_NODES=512
RAG_MAX_CONCURRENCY=4
RAG_DECISION_MAX_AGE=30s

# P2.1 bounded multimodal/document DLP. Development may use the deterministic
# builtin fixture; production requires the private HTTPS/mTLS adapter.
DLP_ATTACHMENT_ENABLED=false
DLP_ATTACHMENT_ADAPTER=builtin
# DLP_ATTACHMENT_EXTRACTOR_URL=https://extractor.example.invalid
# DLP_ATTACHMENT_ALLOWED_HOSTS=media.example.invalid
# DLP_ATTACHMENT_ALLOW_PRIVATE_HOSTS=false
DLP_ATTACHMENT_ALLOWED_MIME_TYPES=image/png,image/jpeg,image/gif,image/webp,application/pdf,text/plain,application/json,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document
DLP_ATTACHMENT_MAX_ENCODED_BYTES=8388608
DLP_ATTACHMENT_MAX_DECODED_BYTES=6291456
DLP_ATTACHMENT_MAX_TEXT_BYTES=1048576
DLP_ATTACHMENT_MAX_COUNT=8
DLP_ATTACHMENT_MAX_PAGES=32
DLP_ATTACHMENT_MAX_EXPANSION_RATIO=20
DLP_ATTACHMENT_TIMEOUT=5s
DLP_ATTACHMENT_MAX_REDIRECTS=2
# DLP_ATTACHMENT_TLS_CA_FILE=/run/secrets/attachment-ca.pem
# DLP_ATTACHMENT_TLS_CERT_FILE=/run/secrets/attachment-client.crt
# DLP_ATTACHMENT_TLS_KEY_FILE=/run/secrets/attachment-client.key
# DLP_ATTACHMENT_TLS_SERVER_NAME=extractor.example.invalid

# P1.6 durable audit. The WAL is append-only, CRC/HMAC chained, and is the
# source for at-least-once SIEM delivery. Production uses mounted files.
AUDIT_WAL_DIR=/tmp/aegisllm-audit
AUDIT_SEGMENT_BYTES=67108864
AUDIT_MAX_BYTES=4294967296
AUDIT_RETENTION=720h
AUDIT_FSYNC=sync
AUDIT_FAILURE_MODE=fail_closed
# AUDIT_HMAC_KEY_FILE=/run/secrets/aegis-audit-hmac-key
# AUDIT_ENCRYPTION_KEYRING_FILE=/run/secrets/aegis-audit-keyring.json
# AUDIT_SIEM_URL=https://siem.example.invalid/ingest
# AUDIT_SIEM_AUTH_FILE=/run/secrets/siem-token
# AUDIT_SIEM_CA_FILE=/run/secrets/siem-ca.pem
# AUDIT_SIEM_CERT_FILE=/run/secrets/siem-client.crt
# AUDIT_SIEM_KEY_FILE=/run/secrets/siem-client.key
# AUDIT_SIEM_SERVER_NAME=siem.example.invalid
AUDIT_SIEM_TIMEOUT=10s
AUDIT_SIEM_BATCH_SIZE=100
AUDIT_SIEM_MAX_RETRIES=8

# Authentication: off preserves local development header compatibility;
# jwt validates a bearer token before protected routes. Never use off outside
# development. HMAC JWT verification is development/test only.
AUTH_MODE=off
# JWT_PUBLIC_KEY_FILE=/run/secrets/aegis-jwt-public.pem
# JWT_HMAC_SECRET=development-only-secret
# Required when AUTH_MODE=jwt:
# JWT_ISSUER=https://issuer.example.invalid
# JWT_AUDIENCE=aegisllm
JWT_TENANT_CLAIM=tenant_id
JWT_APPLICATION_CLAIM=azp
JWT_SUBJECT_CLAIM=sub
JWT_ROLES_CLAIM=roles
JWT_GROUPS_CLAIM=groups
JWT_PROVIDER_CLAIM=provider
# Shadow requires JWT unless this explicit local-only waiver is true.
# ALLOW_UNAUTHENTICATED_SHADOW=true

# Trusted only when AUTH_MODE=off (development compatibility).
HEADER_APPLICATION=X-Application-Id
HEADER_TENANT=X-Tenant-Id
HEADER_USER=X-User-Id
HEADER_TARGET_PROVIDER=X-Target-Provider
DEFAULT_TARGET_PROVIDER=cloud

# Policy-as-code (ticket 02+)
POLICY_FILE=policies/enterprise-default.yaml
QUESTIONS_FILE=questions/security-v1.yaml
THRESHOLDS_FILE=policies/thresholds-security-v1.yaml
# Dedicated HMAC key for finding correlation hashes (empty disables hashing)
# TELEMETRY_HMAC_KEY=
# TELEMETRY_HMAC_KEY_FILE=/run/secrets/telemetry-hmac-key

# Token vault (ticket 06)
# 64 hex chars = 32 bytes AES-256 master key; omit for an ephemeral dev key
# TOKEN_VAULT_KEY=
# TOKEN_VAULT_KEY_FILE=/run/secrets/vault-key
# TOKEN_VAULT_KEYRING_FILE=/run/secrets/vault-keyring.json
# Omit for in-memory vault (development only)
# TOKEN_VAULT_REDIS_URL=redis://localhost:6379/0
# TOKEN_VAULT_REDIS_CA_FILE=/run/secrets/redis-ca.pem
# TOKEN_VAULT_REDIS_CERT_FILE=/run/secrets/redis-client.crt
# TOKEN_VAULT_REDIS_KEY_FILE=/run/secrets/redis-client.key
# TOKEN_VAULT_REDIS_SERVER_NAME=redis.example.invalid
TOKEN_VAULT_TTL=24h

# Semantic decision engine (ticket 08): local laya-serve
# LAYA_URL=http://localhost:8300
# LAYA_TLS_CA_FILE=/run/secrets/laya-ca.pem
# LAYA_TLS_CERT_FILE=/run/secrets/laya-client.crt
# LAYA_TLS_KEY_FILE=/run/secrets/laya-client.key
# LAYA_TLS_SERVER_NAME=laya.example.invalid
LAYA_TIMEOUT=5s
LAYA_EVALUATE_PATH=/v1/evaluate
# Rollout stage 3 only (ticket 11): enable semantic enforcement after calibration
SECURITY_SEMANTIC_ENFORCE=false
